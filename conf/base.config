/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TRON-Bioinformatics/qcpanda Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // Global defaults (only apply when no withName block matches)
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // -----------------------------------------------------------------------
    // nf-core standard labels
    // -----------------------------------------------------------------------
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel:process_gpu {
        ext.use_gpu   = { workflow.profile.contains('gpu') }
        accelerator   = { workflow.profile.contains('gpu') ? 1 : null }
    }
    // Short-lived bookkeeping processes that finish in seconds
    withLabel:process_minimum {
        cpus          = 1
        memory        = { 16.MB + (task.attempt - 1) * 16.MB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // -----------------------------------------------------------------------
    // Process-specific resource requirements
    // Memory start values derived from empirical peak RSS across production runs.
    // Retry increments sized to cover the observed outlier range.
    // -----------------------------------------------------------------------

    // SeqKit Stats — peak RSS ~64–90 MB; start 90 MB, +10 MB per retry x5
    withName: SEQKIT_STATS {
        cpus          = 2
        memory        = { 128.MB + (task.attempt - 1) * 64.MB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // FastQC — peak RSS ~400 MB; start 400 MB, +150 MB per retry x5
    withName: FASTQC {
        cpus          = 3   // max CPU usage ~207%
        memory        = { 512.MB + (task.attempt - 1) * 1024.MB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // fastp — peak RSS ~2 GB; start 2 GB, +1 GB per retry x5
    withName: FASTP {
        cpus          = 8   // max CPU usage ~745%
        memory        = { 2.GB + (task.attempt - 1) * 16.GB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // Sequali — peak RSS ~400–512 MB; start 400 MB, +50 MB per retry x5
    withName: SEQUALI {
        cpus          = 2   // max CPU usage ~186%
        memory        = { 512.MB + (task.attempt - 1) * 128.MB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // FastQ Screen — peak RSS ~900 MB–4 GB; start 900 MB, +50 MB per retry x5
    withName: FASTQSCREEN_FASTQSCREEN {
        cpus          = 6   // max CPU usage ~500%
        memory        = { 4.GB + (task.attempt - 1) * 2.GB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // SortMeRNA index building (lightweight, single run per pipeline)
    withName: SORTMERNA_INDEX {
        cpus          = 6
        memory        = { 4.GB + (task.attempt - 1) * 2.GB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // SortMeRNA rRNA filtering — peak RSS ~8 GB; start 8 GB, +2 GB per retry x4
    withName: SORTMERNA {
        cpus          = 5   // max CPU usage ~463%
        memory        = { 8.GB + (task.attempt - 1) * 2.GB }
        maxRetries    = 4
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // Kraken2 — DB-resident; peak RSS ~64 GB; start 16 GB, +16 GB per retry x5
    withName: KRAKEN2_KRAKEN2 {
        cpus          = 2   // max CPU usage ~102%
        memory        = { 64.GB + (task.attempt - 1) * 16.GB  }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // Downsample (SeqKit Sample) — peak RSS scales with file size; start 2 GB, +2 GB per retry x5
    withName: SEQKIT_SAMPLE {
        cpus          = 2
        memory        = { 2.GB + (task.attempt - 1) * 2.GB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // Bracken abundance estimation
    withName: BRACKEN_BRACKEN {
        cpus          = 1
        memory        = { 512.MB + (task.attempt - 1) * 256.MB }
        maxRetries    = 3
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // Sankey plot (R / plotly, very lightweight)
    withName: SANKEY_PLOT {
        cpus          = 1
        memory        = 256.MB
        maxRetries    = 0
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // NGSCheckMate — align-based; peak RSS ~50 MB; start 50 MB, single attempt
    withName: NGSCHECKMATE_FASTQ {
        cpus          = 6   // max CPU usage ~549%
        memory        = { 64.MB + (task.attempt - 1) * 256.MB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // NGSCheckMate VAF computation
    withName: NGSCHECKMATE_VAFNCM {
        cpus          = 1   // max CPU usage ~13%
        memory        = { 64.MB + (task.attempt - 1) * 64.MB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // NGSCheckMate / NGSCM analysis (R plots + tables)
    withName: NGSCM_ANALYSIS {
        cpus          = 2   // max CPU usage ~100%
        memory        = { 512.MB + (task.attempt - 1) * 128.MB }
        maxRetries    = 4
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // MultiQC
    withName: MULTIQC {
        cpus          = 1   // max CPU usage ~63%
        memory        = { 128.MB + (task.attempt - 1) * 4096.MB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // Generate MultiQC config (Python, tiny)
    withName: GENERATE_MULTIQC_CONFIG {
        cpus          = 1
        memory        = { 512.MB + (task.attempt - 1) * 512.MB }
        maxRetries    = 5
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // SeqKit Pair (repair unequal R1/R2)
    withName: SEQKIT_PAIR {
        cpus          = 2
        memory        = { 256.MB + (task.attempt - 1) * 128.MB }
        maxRetries    = 3
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // SeqKit Sana (sanitise broken FASTQ records)
    withName: SEQKIT_SANA {
        cpus          = 2
        memory        = { 128.MB + (task.attempt - 1) * 64.MB }
        maxRetries    = 3
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    // Gunzip (decompress rRNA ref FASTAs)
    withName: GUNZIP_RRNA_FASTAS {
        cpus          = 1
        memory        = { 64.MB + (task.attempt - 1) * 32.MB }
        maxRetries    = 2
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }
}
