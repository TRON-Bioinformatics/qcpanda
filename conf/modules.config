/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: SEQKIT_SANA {
        ext.prefix = { "${meta.id}_${meta.read_idx + 1}" }
        publishDir = [
            path: { "${params.outdir}/seqkit/sana" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SEQKIT_PAIR {
        ext.prefix = { "${meta.id}" }
        ext.args   = { params.seqkit_keep_unpaired ? '-u' : '' }
        publishDir = [
            path: { "${params.outdir}/seqkit/pair" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.contains('.paired.fastq.gz') && !params.seqkit_keep_paired) return null
                if (filename.contains('.unpaired.fastq.gz') && !params.seqkit_keep_unpaired) return null
                return filename
            }
        ]
    }

    withName: SEQKIT_STATS {
        ext.args = '--skip-err'
        publishDir = [
            path: { "${params.outdir}/seqkit/stats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: SEQUALI {
        // Publish only the HTML report; the JSON is published by SEQUALI_RENAME
        // after sample-name substitution so MultiQC shows correct sample names
        publishDir = [
            path: { "${params.outdir}/sequali" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.html') ? filename : null }
        ]
    }

    withName: SEQUALI_RENAME {
        publishDir = [
            path: { "${params.outdir}/sequali" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_SAMPLE' {
        ext.args   = { "--number ${params.seqkit_sample_n} --rand-seed 100 --two-pass" }
        ext.prefix = { "${meta.id}_R${meta.read_idx + 1}.sampled" }
        publishDir = [
            path: { "${params.outdir}/seqkit/sample" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename.equals('versions.yml') || !params.seqkit_keep_sampled) ? null : filename }
        ]
    }

    withName: 'KRAKEN2_KRAKEN2' {
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // Per-read assignment file is large; only publish if explicitly needed
                if (filename.endsWith('classifiedreads.txt')) return null
                return filename
            }
        ]
    }

    withName: 'KRAKEN2_RATIOS' {
        // Intermediate output consumed by Bracken / NGSCheckMate; not published
        publishDir = [ enabled: false ]
    }

    withName: 'UNTAR_FASTQSCREEN_DB|UNTAR_KRAKEN2_DB|UNTAR_BRACKEN_DB' {
        // Databases are intermediate inputs; extracted files stay in work dir only
        publishDir = [ enabled: false ]
    }

    withName: 'BRACKEN_READ_LENGTH' {
        // Intermediate — k-mer length is passed via channel only
        publishDir = [ enabled: false ]
    }

    withName: 'BRACKEN_BRACKEN' {
        ext.args = { "-r ${meta.read_length}" }
    }

    withName: 'SANKEY_PLOT' {
        ext.args = { "${params.noise_threshold_sankey}" }
        publishDir = [
            path: { "${params.outdir}/sankey_plots" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GENERATE_MULTIQC_CONFIG' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NGSCM_ANALYSIS' {
        publishDir = [
            path: { "${params.outdir}/ngscheckmate" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NGSCHECKMATE_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/ngscheckmate/vafs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NGSCHECKMATE_VAFNCM' {
        publishDir = [
            path: { "${params.outdir}/ngscheckmate" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTQSCREEN' {
        ext.args   = '--subset 100000 --aligner bowtie'
        publishDir = [
            path: { "${params.outdir}/fastq_screen" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GUNZIP_RRNA_FASTAS' {
        // Intermediate step — do not publish unzipped FASTAs
        publishDir = [ enabled: false ]
    }

    withName: 'SORTMERNA_INDEX' {
        ext.args = '--index 1'
        // Index is passed directly to SORTMERNA via channel; no need to publish
        publishDir = [ enabled: false ]
    }

    withName: 'SORTMERNA' {
        ext.args = '--index 0'
        publishDir = [
            path: { "${params.outdir}/sortmerna" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // Only save filtered non-rRNA reads when remove_ribo_rna is true
                if (filename.endsWith('.fastq.gz') && !params.remove_ribo_rna) return null
                return filename
            }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
