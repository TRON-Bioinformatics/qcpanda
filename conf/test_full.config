/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run TRON-Bioinformatics/qcpanda -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function with all optional steps enabled'

    // Input data
    input                    = "${params.pipelines_testdata_base_path}samplesheet/samplesheet.csv"
    ngscm_patient_map        = "${params.pipelines_testdata_base_path}samplesheet/patient_map.csv"

    // Reference databases
    sortmerna_ref_txt        = "${params.pipelines_testdata_base_path}default/sortmerna_ref.txt"
    fastq_screen_references  = "${params.pipelines_testdata_base_path}default/db/fastq_screen_references.csv"
    kraken2_db               = "${params.pipelines_testdata_base_path}default/db/kraken2_db.tar.gz"
    bracken_db               = "${params.pipelines_testdata_base_path}default/db/kraken2_db.tar.gz"
    ngscm_snp_patternsfile   = "${params.pipelines_testdata_base_path}default/SNP.pt"

    // Enable all optional steps
    skip_seqkit_sana         = false
    skip_seqkit_pair         = false
    skip_fastqc              = false
    skip_fastp               = false
    skip_sequali             = false
    skip_fastq_screen        = false
    skip_sortmerna           = false
    skip_kraken2             = false
    skip_bracken             = false
    skip_sankey              = false
    skip_ngscm               = false

    // NGSCheckMate: run on all samples regardless of organism fraction
    execute_ngscm_threshold  = 0.0

    // Read filter: exclude empty FASTQs
    minimum_read_number      = 1
}
