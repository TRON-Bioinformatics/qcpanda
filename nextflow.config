/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TRON-Bioinformatics/qcpanda Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null
    minimum_read_number        = 1

    // SeqKit Sana: sanitize broken FASTQ records before statistics (default: skip)
    skip_seqkit_sana           = true

    // SeqKit Pair: match R1/R2 reads for samples with unequal read counts (default: run)
    // Samples with unequal R1/R2 are dropped from downstream analysis when skipped
    skip_seqkit_pair           = false
    seqkit_keep_paired         = true  // save paired FASTQs to outdir (can be large)
    seqkit_keep_unpaired       = false // save reads without a mate to outdir

    // FastQC: quality control of reads (default: run)
    skip_fastqc                = false

    // Fastp: adapter trimming and quality filtering (default: run)
    skip_fastp                 = false
    fastp_discard_trimmed_pass = false // discard reads that pass quality filters (keep only failed)
    fastp_save_trimmed_fail    = false // save reads that fail quality filters to outdir
    fastp_save_merged          = false // save merged reads when merging paired-end reads

    // Sequali: comprehensive QC reporting (default: run)
    skip_sequali               = false

    // FastQ Screen: contamination screening against multiple genomes (default: run; requires fastq_screen_references)
    skip_fastq_screen          = false
    fastq_screen_references    = null  // path to CSV with columns: name,dir,basename,aligner

    // SortMeRNA: rRNA contamination detection (default: skip; requires sortmerna_ref_txt)
    skip_sortmerna             = true
    sortmerna_ref_txt          = null  // path to text file where each line is a path to a rRNA reference FASTA
    remove_ribo_rna            = false  // when true, filtered non-rRNA FASTQs are saved to outdir

    // Kraken2: organism detection (default: run)
    // When enabled, reads are subsampled via SeqKit Sample before Kraken2
    skip_kraken2               = false
    kraken2_db                 = null   // path to Kraken2 database directory or .tar.gz archive; required when skip_kraken2 is false
    seqkit_sample_n            = 10000  // number of reads to sample per FASTQ file for Kraken2
    seqkit_keep_sampled        = false  // save subsampled FASTQs to outdir (can be large)

    // Bracken: abundance estimation from Kraken2 results (default: run; requires skip_kraken2 = false)
    skip_bracken               = false  // skip Bracken abundance estimation
    bracken_db                 = null   // path to Bracken database directory or .tar.gz archive (may differ from kraken2_db if kmer_distrib files are separate)
    unclassified_ratio_th      = 0.8    // maximum allowed unclassified fraction (0-1) to run Bracken for a sample

    // Sankey: abundance lineage plots from Bracken Kraken2-style reports (default: run; requires skip_bracken = false)
    skip_sankey                = false  // skip Sankey plot generation
    noise_threshold_sankey     = 0.9    // minimum read percentage to include a species lineage in the Sankey plot

    // NGSCheckMate: sample identity verification (default: run)
    skip_ngscm                 = false  // skip NGSCheckMate sample identity check
    ngscm_organism             = 'Homo sapiens' // organism name as reported by Kraken2; used for Kraken2 ratio and NGSCheckMate filtering
    ngscm_snp_patternsfile     = null   // path to NGSCheckMate SNP patterns file (SNP.pt); required when skip_ngscm is false
    ngscm_patient_map          = null   // optional TSV (patient, sample columns) grouping samples by patient for NGSCheckMate analysis plots
    execute_ngscm_threshold    = 0.4    // minimum fraction of target-organism reads (from Kraken2) required to run NGSCheckMate on a sample

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = "https://raw.githubusercontent.com/TRON-Bioinformatics/test-datasets/qcpanda/"
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load TRON-Bioinformatics/qcpanda custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load TRON-Bioinformatics/qcpanda custom profiles from different institutions.
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/qcpanda.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'TRON-Bioinformatics/qcpanda'
    contributors    = [
        [
            name: 'Patrick Sorn',
            affiliation: 'TRON gGmbH',
            email: '',
            github: 'https://github.com/sorn-tron',
            contribution: ['author'],
            orcid: 'https://orcid.org/0000-0001-6179-3014'
        ],
        [
            name: ' Ivan Baksic',
            affiliation: 'TRON gGmbH',
            email: 'baksic.ivan@hotmail.com',
            github: 'https://github.com/Baksic-Ivan/',
            contribution: ['author', 'maintainer'],
            orcid: ''
        ],
        [
            name: ' Johannes Hausmann',
            affiliation: 'TRON gGmbH',
            email: 'johannes.hausmann@tron-mainz.de',
            github: 'https://github.com/johausmann/',
            contribution: ['contributor'],
            orcid: ''
        ],
        [
            name: ' Jonas Ibn-Salem',
            affiliation: 'TRON gGmbH',
            email: 'jonas.ibn-salem@tron-mainz.de',
            github: 'https://github.com/ibn-salem',
            contribution: ['contributor'],
            orcid: 'https://orcid.org/0000-0001-9886-113X'
        ],
    ]
    homePage        = 'https://github.com/TRON-Bioinformatics/qcpanda'
    description     = """qcpanda is a Nextflow (DSL2) pipeline for comprehensive quality control of sequencing data. It takes a tab-separated input table of FASTQ files (single-end or paired-end) and runs a battery of QC tools — including SeqKit, FastQC, Sequali, fastp, SortMeRNA, FastQ Screen, Kraken2/Bracken, and NGSCheckMate — to assess read quality, detect contamination, identify organisms, and check for sample swaps. All results are aggregated into a unified interactive MultiQC report."""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.4'
    version         = '2.0.1'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
